      ],
      "playerDescription": "Dangling root: {{ph:deleted-on-purpose:world:pl-deleted-on-purpose-64}}, inside {{ph:broken-dangling:world:pl-broken-dangling-65}}\n\nDangling mid-path: {{ph:molly:world:pl-molly-66:vdeleted-on-purpose>vhair-north}}\n\nCycle: {{ph:broken-cycle:world:pl-broken-cycle-67}}\n\nEmpty Object: {{ph:broken-empty:world:pl-broken-empty-68}}\n\nSlot nothing carries: {{ph:molly:world:pl-molly-69:sTail}}\n\nStale ownership: {{ph:broken-orphan:world:pl-broken-orphan-70}} and {{ph:broken-released:world:pl-broken-released-71}}, held by {{ph:broken-holder:world:pl-broken-holder-72}}.",
      "aiDescription": "The corner of the world where every Test Bench rule has something to find."
    }
