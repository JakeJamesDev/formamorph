# Cloudflare Pages response headers for the upload root.

# Vite hashes every filename under assets/, so a year is safe and a new release changes the name.
/play/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The account pages' own bundle, hashed the same way. Its HTML is deliberately not listed: it is served
# through a rewrite, so the request path is /login rather than a path under /site-app/.
/site-app/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Scripts and styles the site's HTML loads by a fixed name. Pages caches them for 4 hours by default,
# which puts an old header over a new page; revalidating makes a deploy live on the next visit.
/theme.js
  Cache-Control: public, max-age=0, must-revalidate
/session.js
  Cache-Control: public, max-age=0, must-revalidate
/site-header.css
  Cache-Control: public, max-age=0, must-revalidate
/site-app/header.js
  Cache-Control: public, max-age=0, must-revalidate

# The model and animation files keep their names across releases. A day, so a replacement reaches
# players without a network round trip on every visit.
/play/*.vrm
  Cache-Control: public, max-age=86400
/play/*.fbx
  Cache-Control: public, max-age=86400

# The site's own images and icons. They are not content-hashed, so a day rather than a year: a
# recapture reaches visitors on their next day without a round trip on every visit. The site's HTML
# is deliberately not listed, so Pages keeps revalidating it and a page edit is live immediately.
/site/*
  Cache-Control: public, max-age=86400
