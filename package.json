  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "preview": "vite preview",
    "desktop:dev": "vite build && electron .",
    "desktop:build": "vite build && electron-builder --win dir --publish never",
    "desktop:build:linux": "vite build && electron-builder --linux AppImage --publish never",
    "desktop:build:linux:publish": "vite build && electron-builder --linux AppImage --publish always",
    "desktop:build:mac": "vite build && electron-builder --mac dmg --publish never",
    "vram-helper": "node scripts/vram-helper.mjs",
    "gen-tags": "node scripts/genDanbooruTags.mjs",
    "docs": "typedoc",
    "changelog:notes": "node scripts/extractReleaseNotes.mjs",
    "baseline": "node testing/baseline/harness/run.mjs",
    "screen": "node testing/baseline/harness/screen.mjs"
  },
